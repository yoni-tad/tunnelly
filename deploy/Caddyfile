# Tunnelly — recommended Caddy config (wildcard certificate via DNS-01).
#
# A wildcard certificate (*.example.com) can only be issued with a DNS challenge,
# so Caddy needs your DNS provider's plugin. This example uses Cloudflare;
# see https://github.com/caddy-dns for others. Install with:
#
#   sudo caddy add-package github.com/caddy-dns/cloudflare
#
# and give Caddy an API token with Zone:DNS:Edit permission
# (e.g. Environment=CLOUDFLARE_API_TOKEN=... in `systemctl edit caddy`).
#
# Replace example.com with your DOMAIN.

{
	email you@example.com
}

example.com, *.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	# Caddy proxies WebSocket upgrades automatically, preserves the Host header,
	# and sets X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host.
	reverse_proxy 127.0.0.1:4000 {
		# Stream responses immediately (no buffering).
		flush_interval -1
		# Keep tunnel WebSockets alive across `caddy reload` instead of cutting them.
		stream_close_delay 1h
	}
}
