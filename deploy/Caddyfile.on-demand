# Tunnelly — alternative Caddy config WITHOUT a DNS provider plugin.
#
# Uses "on-demand TLS": Caddy obtains a certificate for each tunnel hostname the
# first time it is visited (via the normal HTTP challenge). Simpler to set up,
# but:
#   - the first request to a new tunnel URL takes a few seconds
#   - Let's Encrypt allows 50 certificates per registered domain per week, and
#     every new tunnel URL needs one. Fine for light use; prefer the wildcard
#     setup (deploy/Caddyfile) if you start tunnels many times a day.
#
# Tunnelly's /_tunnelly/tls-check endpoint only approves the dashboard host and
# the currently active tunnel, so random hostnames can't trigger issuance.
#
# Set DOMAIN in Tunnelly's .env; nothing here needs your domain except the email.

{
	email you@example.com
	on_demand_tls {
		ask http://127.0.0.1:4000/_tunnelly/tls-check
	}
}

# Every HTTPS hostname, on demand; the `ask` endpoint above decides which are allowed.
https:// {
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:4000 {
		flush_interval -1
		stream_close_delay 1h
	}
}
