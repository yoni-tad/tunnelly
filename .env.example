# Tunnelly server settings. In Dokploy, paste these into the app's "Environment" tab.
# Local development needs none of this.

# The one public URL. The tunnel is served here; the dashboard at PUBLIC_URL/_tunnelly/
PUBLIC_URL=https://tunnelly.yoni-tad.com

# Dashboard password (browser login prompt, any username). Required in production.
DASHBOARD_PASSWORD=change-me

# ── Optional ─────────────────────────────────────────────────────────────────
# Require the CLI to send this secret (set TUNNELLY_TOKEN on your laptop).
# Stops anyone else from opening a tunnel on your URL while yours is off.
# TUNNEL_CONNECT_TOKEN=

# REQUEST_TIMEOUT_MS=60000     # 504 if your local app is silent this long
# MAX_REQUEST_BODY_MB=50
# RESUME_GRACE_MS=120000       # how long a dropped CLI can reconnect to its session
# LOG_FORMAT=pretty            # or json
