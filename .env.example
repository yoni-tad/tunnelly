# ─────────────────────────────────────────────────────────────────────────────
# Tunnelly server configuration (production). Copy to .env on your VPS.
# Local development needs NO .env — the defaults use http://localhost:4000.
# ─────────────────────────────────────────────────────────────────────────────

# Tunnels are served at https://<random>.DOMAIN; the dashboard at https://DOMAIN.
# DNS must point both DOMAIN and *.DOMAIN at this server.
# Tip: use a dedicated subdomain (tunnel.example.com) to keep your apex free.
DOMAIN=example.com

# Public URL of this server. `npm run build` bakes it into the CLI as the default,
# so `npx tunnel 3000` connects here with zero configuration.
SERVER_URL=https://example.com

PORT=4000
# Bind to loopback: only the reverse proxy (Caddy/nginx) should reach Node.
HOST=127.0.0.1
NODE_ENV=production

# HTTP Basic auth for the dashboard (any username). Required in production.
DASHBOARD_PASSWORD=change-me-to-something-long

# ── Optional ────────────────────────────────────────────────────────────────

# Require the CLI to present this token (set TUNNELLY_TOKEN on the CLI side).
# Stops strangers from opening tunnels on your domain while yours is idle.
# TUNNEL_CONNECT_TOKEN=

# Public URL scheme/port. Defaults: https and 443 in production.
# PUBLIC_PROTOCOL=https
# PUBLIC_PORT=

# Trust X-Forwarded-* from the reverse proxy (default: true in production).
# TRUST_PROXY=true

# Extra hostnames that serve the dashboard (comma-separated).
# APP_HOSTS=localhost,127.0.0.1

# 504 if the local app sends nothing for this long.
# REQUEST_TIMEOUT_MS=60000
# MAX_REQUEST_BODY_MB=50

# Heartbeat: ping every 15s; a CLI silent for 45s is considered gone.
# HEARTBEAT_INTERVAL_MS=15000
# HEARTBEAT_TIMEOUT_MS=45000

# After an unexpected drop, keep the URL reserved this long so the CLI can resume it.
# RESUME_GRACE_MS=120000

# Number of requests kept in memory for the dashboard.
# REQUEST_LOG_LIMIT=1000

# LOG_LEVEL=info          # debug | info | warn | error
# LOG_FORMAT=pretty       # pretty | json
